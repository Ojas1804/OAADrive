[Unit]
Description=OAADrive Home Server (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Path to your clone of the OAADrive repo (contains docker-compose.yml).
# setup.sh generates and installs this file automatically with the
# correct path — this copy is kept as a reference/manual-install template.
WorkingDirectory=/home/YOUR_USERNAME/OAADrive
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
