# Copy this file to .env and fill in real values.
# Never commit the real .env to version control.

# --- SeaweedFS (S3-compatible object storage) ---
# These must match the accessKey/secretKey inside seaweedfs-s3.json
# (copy seaweedfs-s3.example.json to seaweedfs-s3.json and fill in the
# same values, or let setup.sh generate both files for you).
SEAWEEDFS_ACCESS_KEY=change_me_access_key
SEAWEEDFS_SECRET_KEY=change_me_to_a_long_random_secret
# Path on the host (your external disk) where SeaweedFS stores objects
SEAWEEDFS_DATA_PATH=/mnt/external-disk/seaweedfs-data

# --- Postgres ---
POSTGRES_USER=homeserver
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=homeserver
# Path on the host where Postgres stores its data files
POSTGRES_DATA_PATH=/mnt/external-disk/postgres-data

# --- Go API ---
JWT_SECRET=change_me_to_a_long_random_string
API_PORT=8080

# --- React web (nginx) ---
WEB_PORT=3000
