# Copy this file to .env and fill in real values.
# Never commit the real .env to version control.

# --- MinIO ---
MINIO_ROOT_USER=change_me_admin
MINIO_ROOT_PASSWORD=change_me_to_a_long_random_password
# Path on the host (your external disk) where MinIO stores objects
MINIO_DATA_PATH=/mnt/external-disk/minio-data

# --- Postgres ---
POSTGRES_USER=homeserver
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=homeserver
# Path on the host where Postgres stores its data files
POSTGRES_DATA_PATH=/mnt/external-disk/postgres-data
